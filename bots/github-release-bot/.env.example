# OpenChat server base URL (no trailing slash)
OPENCHAT_URL=https://chat.creeger.com
# Bot token from POST /api/bots (shown once at creation)
BOT_TOKEN=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: a GitHub token to raise the API rate limit (public repos work without one)
GITHUB_TOKEN=
# How often to poll GitHub (seconds; min 60)
POLL_INTERVAL_SEC=300
# Command prefix users type in chat
CMD_PREFIX=!gh
# Where to persist watch config (the compose file mounts ./data -> /data)
DATA_FILE=/data/watches.json
