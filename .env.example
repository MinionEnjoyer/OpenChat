# =============================================================================
#  OpenChat — configuration
#  This is the ONE config file for the whole stack. Copy it and fill it in:
#
#      cp .env.example .env      # then edit .env  (never commit .env)
#      ./scripts/setup.sh        # renders livekit.yaml from .env
#
#  Everything personal (keys, tokens, passwords, the public IP) lives in the
#  local .env only — it is gitignored and never pushed. Templates like this
#  file ARE committed, so keep real secrets OUT of here.
#  Replace every CHANGE_ME below. Generate secrets with:  openssl rand -hex 32
# =============================================================================

# ── deployment identity / hosts ──────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
WEB_ORIGIN=https://chat.example.com     # public URL users load the app from
WEB_PORT=8810                            # host port the web container binds (proxy → here)

# Service hostnames (used for server-side host pinning below). Match your domains.
CHAT_HOST=chat.example.com
AUTH_HOST=auth.example.com
SHARE_HOST=share.example.com
WATCH_HOST=watch.example.com

# LAN IP of the host running your reverse proxy. Server-side calls to the hosts
# above are pinned to this IP (public DNS points at an edge the container can't reach).
LAN_HOST_IP=192.168.1.10

# ── database (compose builds DATABASE_URL from these) ─────────────────────────
POSTGRES_USER=chat
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=chat
# For non-Docker local dev only, point at your own Postgres:
# DATABASE_URL=postgresql://chat:chat@localhost:5432/chat

# ── redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── sessions ─────────────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_long_random_min_16_chars

# ── auth: Authentik OIDC (from your 'chat' provider) ─────────────────────────
OIDC_ISSUER=https://auth.example.com/application/o/chat/
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=https://chat.example.com/api/auth/callback
# Native PKCE redirect URI for mobile apps (deep-link scheme). Defaults to openchat://auth
# if unset — the Zod schema falls back so the server always resolves a value.
NATIVE_REDIRECT_URI=openchat://auth
OIDC_POST_LOGOUT_REDIRECT_URI=https://chat.example.com

# ── file uploads: OpenShare (OPTIONAL) ───────────────────────────────────────
# Point SHARE_BASE_URL at your OpenShare instance (https://github.com/MinionEnjoyer/OpenShare)
# to enable image/file uploads, avatars, soundboard sounds, and inline embeds. Leave blank to
# run without uploads (upload UI hides).
#
# SHARE_API_KEY is a shared secret: uploads go through this app's API, which stores to OpenShare
# on the user's behalf using this key. Set it to a random value (openssl rand -hex 32) and put
# the SAME value in OpenShare's .env as SHARE_API_KEY. Client uploads and media reads stay on
# OpenChat's authenticated /api routes; the API talks to OpenShare server-to-server.
SHARE_BASE_URL=https://share.example.com
SHARE_API_KEY=CHANGE_ME

# Optional upload limits for operators who want them. Unset = unlimited.
# UPLOAD_MAX_FILES=20
# UPLOAD_MAX_FILE_BYTES=1073741824

# Realtime abuse/backpressure safeguards. Defaults shown here.
# WS_MAX_PAYLOAD_BYTES=1048576
# WS_MAX_SOCKETS_PER_USER=10
# WS_MAX_SUBSCRIPTIONS=500
# WS_MAX_OPERATIONS_PER_WINDOW=120
# WS_OPERATION_WINDOW_MS=10000
# WS_MAX_BUFFERED_BYTES=1048576

# API docs remain available outside production; opt in to expose them in production.
# ENABLE_API_DOCS=0

# ── trusted mirror cluster (OPTIONAL) ────────────────────────────────────────
# Enables persistent, authenticated message replication between OpenChat hosts.
# Leave disabled for normal single-host installs. Every node uses a unique ID,
# the same 32+ character cluster secret, and an HTTPS URL for every other node.
# This is a trusted operator-managed cluster, not open internet federation.
FEDERATION_ENABLED=0
# FEDERATION_NODE_ID=west
# FEDERATION_SHARED_SECRET=CHANGE_ME_at_least_32_random_characters
# FEDERATION_PEERS='[{"id":"east","url":"https://east.chat.example.com"}]'

# ── Patreon membership invitations (OPTIONAL) ────────────────────────────────
# Allows server owners to issue one-use invitations after live Patreon
# membership verification. Patreon access tokens are not retained.
PATREON_ENABLED=0
# PATREON_CLIENT_ID=
# PATREON_CLIENT_SECRET=
# PATREON_REDIRECT_URI=https://chat.example.com/api/patreon/callback

# ── watch parties: Jellyfin (API key optional) ───────────────────────────────
JELLYFIN_URL=https://watch.example.com
JELLYFIN_API_KEY=

# ── voice / video: LiveKit ───────────────────────────────────────────────────
# API key/secret are shared with the LiveKit server (livekit.yaml is rendered
# from these by scripts/setup.sh — keep them in sync automatically).
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME_long_random
# HTTP URL the API uses to read LiveKit's live voice roster (self-heals ghost participants).
# Point at the LiveKit server's HTTP port, reachable from the API container. Optional.
LIVEKIT_API_URL=http://livekit.internal:7880
# Public IP that call clients reach for WebRTC media (your edge/VPS, or this host).
LIVEKIT_NODE_IP=CHANGE_ME_public_ip
# Optional YAML flow list of RTC interfaces. Leave [] for automatic selection;
# a relayed deployment can pin media to its tunnel, for example [wg0].
LIVEKIT_RTC_INTERFACE_INCLUDES=[]

# ── GIFs: Giphy (optional; picker hides itself if empty) ─────────────────────
GIPHY_API_KEY=

# ── push notifications: Firebase Cloud Messaging (OPTIONAL) ─────────────────
# Paste the full JSON service-account key here (single line or multi-line).
# Leave blank to disable push entirely (NoopPushTransport degrades gracefully).
# VALIDATED at boot by the Zod schema — a typo in the key name is no longer silent.
FCM_SERVICE_ACCOUNT=

# Signs bearer access tokens for native clients (P1-01). Generate a long random value.
JWT_SECRET=

# ── Push notifications (optional) ────────────────────────────────────────────
# Push is OFF unless FCM_SERVICE_ACCOUNT is set. With it unset the API loads a
# no-op transport, logs that push is disabled, and everything else works
# normally — so this is safe to leave blank.
#
# Both halves must come from the SAME Firebase project, because FCM tokens are
# project-scoped: a token minted by one project cannot be pushed to by another
# project's credentials.
#
#   1. Server (secret): Firebase Console -> Project settings -> Service accounts
#      -> Generate new private key. Paste the JSON here on ONE line, wrapped in
#      SINGLE quotes so the embedded double quotes survive shell sourcing:
#        FCM_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...",...}'
#      This contains a private key. It belongs only in the deployed server's
#      environment — never in git, a PR, or a chat message.
#
#   2. Client (not secret): Firebase Console -> Add app -> Android, using the
#      applicationId from apps/mobile/app.json. Download google-services.json to
#      apps/mobile/android/app/. It ships inside every APK and is extractable
#      from it, so it is not confidential — but it IS gitignored, because it
#      identifies one specific Firebase project rather than being a shared
#      default. Whoever builds the APK supplies their own.
#
# FCM_SERVICE_ACCOUNT=
