# =============================================================================
# OpenChat — dev stack environment (used by docker-compose.dev.yml)
# =============================================================================

NODE_ENV=development
DEV_AUTH=1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000

# Service hostnames (dev: all local)
CHAT_HOST=localhost
AUTH_HOST=localhost
SHARE_HOST=localhost
WATCH_HOST=localhost
LAN_HOST_IP=127.0.0.1

# Postgres
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat

# Redis
REDIS_URL=redis://redis:6379

# Sessions
SESSION_SECRET=dev-dev-dev-dev-16

# OIDC (placeholder — dev-login bypasses Auth with DEV_AUTH=1)
OIDC_ISSUER=https://auth.example.com/application/o/chat/
OIDC_CLIENT_ID=dev
OIDC_CLIENT_SECRET=dev
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# OpenShare
SHARE_BASE_URL=http://openshare:8800
SHARE_API_KEY=dev-share-key

# Jellyfin (optional)
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# LiveKit (dev keys match livekit.dev.yaml)
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecret12
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_NODE_IP=127.0.0.1

# Giphy (optional)
GIPHY_API_KEY=
# P1-01: signs bearer access tokens (new)
JWT_SECRET=dev-jwt-secret-not-for-prod
