{
  "name": "@chat/api",
  "version": "0.8.46",
  "description": "Chat API Backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:char": "jest --config jest-char.config.js --forceExit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@prisma/client": "^5.12.1",
    "connect-redis": "^7.1.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "livekit-server-sdk": "^2.1.3",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.0.0",
    "openid-client": "^5.6.5",
    "pino-http": "^9.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/passport": "^1.0.16",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "ajv": "^8.20.0",
    "eslint": "^10.8.1",
    "jest": "^29.7.0",
    "js-yaml": "^5.2.2",
    "prisma": "^5.12.1",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  },
  "overrides": {
    "@nestjs/swagger@11.4.6": {
      "js-yaml": "5.2.3"
    },
    "minimatch@<4": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@>=10": {
      "brace-expansion": "5.0.9"
    },
    "@typescript-eslint/typescript-estree@8.65.0": {
      "brace-expansion": "5.0.9"
    },
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.1"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "lines": 75
      }
    },
    "testEnvironment": "node"
  }
}
