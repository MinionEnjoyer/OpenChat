generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id         String   @id
  serverId   String
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [actorId], references: [id])
  Server     Server   @relation(fields: [serverId], references: [id])

  @@index([serverId])
}

model Ban {
  id                         String   @id
  serverId                   String
  userId                     String
  reason                     String?
  createdById                String
  deleteMessageDays          Int?
  createdAt                  DateTime @default(now())
  User_Ban_createdByIdToUser User     @relation("Ban_createdByIdToUser", fields: [createdById], references: [id], onDelete: Cascade)
  Server                     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  User_Ban_userIdToUser      User     @relation("Ban_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId])
}

model Category {
  id       String    @id
  serverId String
  name     String
  position Int
  Server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  Channel  Channel[]

  @@index([serverId])
}

model Channel {
  id               String             @id
  serverId         String?
  categoryId       String?
  name             String
  type             ChannelType        @default(TEXT)
  topic            String?
  position         Int                @default(0)
  parentId         String?
  Category         Category?          @relation(fields: [categoryId], references: [id])
  Channel          Channel?           @relation("ChannelToChannel", fields: [parentId], references: [id])
  other_Channel    Channel[]          @relation("ChannelToChannel")
  Server           Server?            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  ChannelOverwrite ChannelOverwrite[]
  ChannelRecipient ChannelRecipient[]
  Invite           Invite[]
  Message          Message[]
  ReadState        ReadState[]
  VoiceSession     VoiceSession[]
  WatchParty       WatchParty[]

  @@index([categoryId])
  @@index([serverId])
}

model ChannelOverwrite {
  id         String              @id
  channelId  String
  targetType OverwriteTargetType
  targetId   String
  allow      BigInt              @default(0)
  deny       BigInt              @default(0)
  Channel    Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, targetType, targetId])
  @@index([channelId])
}

model ChannelRecipient {
  id        String   @id
  channelId String
  userId    String
  joinedAt  DateTime @default(now())
  Channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model DeviceToken {
  id       String   @id
  userId   String
  token    String
  platform String
  lastSeen DateTime @default(now())
  User     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model Friendship {
  id                                String       @id
  requesterId                       String
  addresseeId                       String
  status                            FriendStatus @default(PENDING)
  createdAt                         DateTime     @default(now())
  updatedAt                         DateTime
  User_Friendship_addresseeIdToUser User         @relation("Friendship_addresseeIdToUser", fields: [addresseeId], references: [id], onDelete: Cascade)
  User_Friendship_requesterIdToUser User         @relation("Friendship_requesterIdToUser", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Invite {
  id        String    @id
  code      String    @unique
  serverId  String
  channelId String?
  inviterId String
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  Channel   Channel?  @relation(fields: [channelId], references: [id])
  User      User      @relation(fields: [inviterId], references: [id])
  Server    Server    @relation(fields: [serverId], references: [id])

  @@index([code])
}

model Message {
  id                String              @id
  channelId         String
  authorId          String
  content           String
  createdAt         DateTime            @default(now())
  editedAt          DateTime?
  deletedAt         DateTime?
  replyToId         String?
  pinned            Boolean             @default(false)
  User              User                @relation(fields: [authorId], references: [id])
  Channel           Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  Message           Message?            @relation("MessageToMessage", fields: [replyToId], references: [id])
  other_Message     Message[]           @relation("MessageToMessage")
  MessageAttachment MessageAttachment[]
  Poll              Poll?
  Reaction          Reaction[]

  @@index([channelId, createdAt])
}

model MessageAttachment {
  id           String  @id
  messageId    String
  shareAssetId String
  filename     String
  mimeType     String
  size         BigInt
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  durationMs   Int?
  Message      Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model NotificationSetting {
  id         String            @id
  userId     String
  mutedUntil DateTime?
  scope      NotificationScope
  scopeId    String
  level      NotificationLevel @default(ALL)
  User       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, scopeId])
}

model Poll {
  id         String       @id
  messageId  String       @unique
  question   String
  multiple   Boolean      @default(false)
  closesAt   DateTime?
  createdAt  DateTime     @default(now())
  Message    Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  PollOption PollOption[]
}

model PollOption {
  id       String     @id
  pollId   String
  text     String
  position Int        @default(0)
  Poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  PollVote PollVote[]

  @@index([pollId])
}

model PollVote {
  id         String     @id
  optionId   String
  userId     String
  createdAt  DateTime   @default(now())
  PollOption PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  User       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([optionId])
}

model Reaction {
  id        String  @id
  messageId String
  userId    String
  emoji     String
  Message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model ReadState {
  id                String  @id
  userId            String
  channelId         String
  lastReadMessageId String?
  mentionCount      Int     @default(0)
  Channel           Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Role {
  id           String         @id
  serverId     String
  name         String
  color        Int            @default(0)
  permissions  BigInt         @default(0)
  position     Int
  mentionable  Boolean        @default(true)
  Server       Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  ServerMember ServerMember[]

  @@index([serverId])
}

model Server {
  id               String             @id
  name             String
  ownerId          String
  iconUrl          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  AuditLog         AuditLog[]
  Ban              Ban[]
  Category         Category[]
  Channel          Channel[]
  Invite           Invite[]
  Role             Role[]
  User             User               @relation(fields: [ownerId], references: [id])
  ServerInvitation ServerInvitation[]
  ServerMember     ServerMember[]
  ServerSound      ServerSound[]

  @@index([ownerId])
}

model ServerInvitation {
  id                                    String             @id
  serverId                              String
  inviterId                             String
  inviteeId                             String
  status                                ServerInviteStatus @default(PENDING)
  createdAt                             DateTime           @default(now())
  User_ServerInvitation_inviteeIdToUser User               @relation("ServerInvitation_inviteeIdToUser", fields: [inviteeId], references: [id], onDelete: Cascade)
  User_ServerInvitation_inviterIdToUser User               @relation("ServerInvitation_inviterIdToUser", fields: [inviterId], references: [id], onDelete: Cascade)
  Server                                Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, inviteeId])
  @@index([inviteeId, status])
}

model ServerMember {
  id            String    @id
  serverId      String
  userId        String
  nickname      String?
  joinedAt      DateTime  @default(now())
  timedOutUntil DateTime?
  Server        Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Role          Role[]

  @@unique([serverId, userId])
}

model ServerSound {
  id        String   @id
  serverId  String
  name      String
  emoji     String?
  url       String
  createdAt DateTime @default(now())
  Server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

model User {
  id                                                String                @id
  authSub                                           String                @unique
  username                                          String
  displayName                                       String?
  avatarUrl                                         String?
  status                                            UserStatus            @default(OFFLINE)
  createdAt                                         DateTime              @default(now())
  updatedAt                                         DateTime
  friendCode                                        String?               @unique
  serverLayout                                      Json?
  AuditLog                                          AuditLog[]
  Ban_Ban_createdByIdToUser                         Ban[]                 @relation("Ban_createdByIdToUser")
  Ban_Ban_userIdToUser                              Ban[]                 @relation("Ban_userIdToUser")
  ChannelRecipient                                  ChannelRecipient[]
  DeviceToken                                       DeviceToken[]
  Friendship_Friendship_addresseeIdToUser           Friendship[]          @relation("Friendship_addresseeIdToUser")
  Friendship_Friendship_requesterIdToUser           Friendship[]          @relation("Friendship_requesterIdToUser")
  Invite                                            Invite[]
  Message                                           Message[]
  NotificationSetting                               NotificationSetting[]
  PollVote                                          PollVote[]
  Reaction                                          Reaction[]
  ReadState                                         ReadState[]
  Server                                            Server[]
  ServerInvitation_ServerInvitation_inviteeIdToUser ServerInvitation[]    @relation("ServerInvitation_inviteeIdToUser")
  ServerInvitation_ServerInvitation_inviterIdToUser ServerInvitation[]    @relation("ServerInvitation_inviterIdToUser")
  ServerMember                                      ServerMember[]
  VoiceSession                                      VoiceSession[]
  WatchParty                                        WatchParty[]

  @@index([authSub])
}

model VoiceSession {
  id        String    @id
  channelId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  Channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  User      User      @relation(fields: [userId], references: [id])

  @@index([channelId])
}

model WatchParty {
  id             String    @id
  channelId      String
  hostId         String
  jellyfinItemId String
  positionMs     Int       @default(0)
  paused         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  endedAt        DateTime?
  Channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  User           User      @relation(fields: [hostId], references: [id])

  @@index([channelId])
}

enum ChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
  DM
  GROUP_DM
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum NotificationLevel {
  ALL
  MENTIONS
  NONE
}

enum NotificationScope {
  SERVER
  CHANNEL
}

enum OverwriteTargetType {
  ROLE
  MEMBER
}

enum ServerInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum UserStatus {
  ONLINE
  AWAY
  DND
  INVISIBLE
  OFFLINE
}
