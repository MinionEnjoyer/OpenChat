  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
