#!/usr/bin/env bash
# devctl — dev stack lifecycle management for OpenChat
# Usage: ./tools/devctl stack up|down|reset|logs|health [--json]
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
COMPOSE_FILE="$ROOT/docker-compose.dev.yml"
COMPOSE_CMD="docker compose -f $COMPOSE_FILE"

read_phase() {
  # Return the current phase number from .phase at repo root.
  # Single source of truth for which phase the project is in.
  local phase_file="$ROOT/.phase"
  if [ -f "$phase_file" ]; then
    head -n1 "$phase_file" | tr -d '[:space:]'
  else
    echo "0"
  fi
}

json_out() {
  # --json flag present anywhere in args → emit JSON
  for a in "$@"; do [ "$a" = "--json" ] && return 0; done
  return 1
}

cmd_stack_up() {
  echo "[devctl] starting dev stack…"
  $COMPOSE_CMD up --build -d "$@"
}

cmd_stack_down() {
  echo "[devctl] stopping dev stack…"
  $COMPOSE_CMD down "$@"
}

cmd_stack_reset() {
  echo "[devctl] resetting dev stack (down + volumes + up)…"
  $COMPOSE_CMD down -v "$@"
  $COMPOSE_CMD up --build -d "$@"
}

cmd_stack_logs() {
  shift # consume 'logs'
  $COMPOSE_CMD logs "$@"
}

cmd_stack_health() {
  shift # consume 'health'
  local failures=0 r_pg="" r_rd="" r_ap="" r_wb="" r_lk="" r_os="" r_ah=""
  local want_json=false
  json_out "$@" && want_json=true

  echo "[devctl] health check…"

  # postgres
  if nc -z -w 3 localhost 5432 2>/dev/null; then
    $want_json && r_pg="ok" || echo "  ✓ postgres (localhost:5432)"
  else
    failures=$((failures + 1))
    $want_json && r_pg="unreachable" || echo "  ✗ postgres (localhost:5432) — unreachable"
  fi

  # redis
  if nc -z -w 3 localhost 6379 2>/dev/null; then
    $want_json && r_rd="ok" || echo "  ✓ redis (localhost:6379)"
  else
    failures=$((failures + 1))
    $want_json && r_rd="unreachable" || echo "  ✗ redis (localhost:6379) — unreachable"
  fi

  # api
  if nc -z -w 3 localhost 3001 2>/dev/null; then
    $want_json && r_ap="ok" || echo "  ✓ api (localhost:3001)"
  else
    failures=$((failures + 1))
    $want_json && r_ap="unreachable" || echo "  ✗ api (localhost:3001) — unreachable"
  fi

  # web
  if nc -z -w 3 localhost 3000 2>/dev/null; then
    $want_json && r_wb="ok" || echo "  ✓ web (localhost:3000)"
  else
    failures=$((failures + 1))
    $want_json && r_wb="unreachable" || echo "  ✗ web (localhost:3000) — unreachable"
  fi

  # livekit
  if nc -z -w 3 localhost 7880 2>/dev/null; then
    $want_json && r_lk="ok" || echo "  ✓ livekit (localhost:7880)"
  else
    failures=$((failures + 1))
    $want_json && r_lk="unreachable" || echo "  ✗ livekit (localhost:7880) — unreachable"
  fi

  # openshare
  if nc -z -w 3 localhost 8800 2>/dev/null; then
    $want_json && r_os="ok" || echo "  ✓ openshare (localhost:8800)"
  else
    failures=$((failures + 1))
    $want_json && r_os="unreachable" || echo "  ✗ openshare (localhost:8800) — unreachable"
  fi

  # API health endpoint (200 = ok)
  if curl -sf -o /dev/null "http://localhost:3001/api/health" 2>/dev/null; then
    $want_json && r_ah="ok" || echo "  ✓ GET /api/health → 200"
  else
    failures=$((failures + 1))
    $want_json && r_ah="fail" || echo "  ✗ GET /api/health → failed"
  fi

  if $want_json; then
    printf '{"postgres":"%s","redis":"%s","api":"%s","web":"%s","livekit":"%s","openshare":"%s","api_health":"%s"}\n' \
      "${r_pg:-unknown}" "${r_rd:-unknown}" "${r_ap:-unknown}" "${r_wb:-unknown}" \
      "${r_lk:-unknown}" "${r_os:-unknown}" "${r_ah:-unknown}"
  fi

  return $failures
}

# ── Contamination sweep patterns ──
# These regexes detect tool-output XML artifacts and markdown fences leaked into
# non-markdown source files. This class of error is 100% mechanical — code review
# won't catch stray `</write_to_file>` in a .sh file. Run on every doctor check.
CONTAM_RE=$(cat <<'REGEX'
</?write_to_file|</?invoke|</?parameter|</?task_progress|</?attempt_completion|</?read_file|</?search_files|</?replace_in_file|</?execute_command|</?list_files|</?list_code_definition_names|</?use_mcp_tool|</?ask_followup_question|</?plan_mode_respond|</?generate_explanation|</?access_mcp_resource|</?load_mcp_documentation
REGEX
)

cmd_contamination_sweep() {
  # Returns 0 if clean, 1 with list of hits if contamination found.
  local hits
  hits=$(grep -rnE "$CONTAM_RE" \
    --include='*.sh' --include='*.mjs' --include='*.js' --include='*.ts' \
    --include='*.yml' --include='*.yaml' --include='*.json' --include='*.py' \
    --include='*.html' --include='*.css' --include='*.toml' --include='*.env' \
    --include='*.conf' "$ROOT" 2>/dev/null | grep -v node_modules | grep -v '.git/')
  if [ -n "$hits" ]; then
    echo "$hits"
    return 1
  fi
  return 0
}

cmd_doctor() {
  # Assert presence of every required artifact. Exits nonzero with JSON list of missing paths.
  # Required artifacts per docs/audits/artifact-inventory.md — keep in sync.
  local missing=()
  local paths=(
    "contracts/x-attachment-shape.yaml"
    "docs/BACKLOG.md"
    "docs/DRIFT-LOG.md"
    "docs/LOG.md"
    "docs/audits/P0-04.md"
    "docs/audits/P0-04-remediation.md"
    "docs/audits/P0-04-verification.md"
    "docs/audits/artifact-inventory.md"
    "docs/capabilities/EXPERIMENTS.md"
    "docs/capabilities/experiment-outputs/E1.txt"
    "docs/capabilities/experiment-outputs/E2.json"
    "docs/capabilities/experiment-outputs/E3.json"
    "docs/capabilities/experiment-outputs/E4.txt"
    "docs/capabilities/experiment-outputs/E5.json"
    "docs/capabilities/experiment-outputs/E5.txt"
    "docs/capabilities/experiment-outputs/E6.json"
    "docs/capabilities/experiment-outputs/E7.json"
    "docs/capabilities/experiment-outputs/E8.json"
    "docs/capabilities/experiment-outputs/E9.txt"
    "docs/capabilities/experiment-outputs/E10.txt"
    "docs/capabilities/experiment-outputs/E11.json"
    "specs/00-MASTER-SPEC.md"
    "specs/05-AGENT-OPERATIONS.md"
    "specs/templates/T2-AUDIT-CHECKLIST.md"
    "tools/seed/seed.mjs"
    "tools/devctl"
    "tools/devctl-README.md"
    ".phase"
  )
  # ── .phase value must be a non-negative integer ──
  local phase_val
  phase_val=$(read_phase)
  if ! echo "$phase_val" | grep -qE '^[0-9]+$'; then
    missing+=(".phase: invalid value '$phase_val' — must be a non-negative integer")
  fi
  # ── Stale fixture-ids.json check: if the file exists but is older than the last DB reset,
  # ── flag it so Phase 1 E2E doesn't silently reference wrong fixture ids.
  local fid_path="$ROOT/tools/seed/fixture-ids.json"
  if [ -f "$fid_path" ]; then
    local postgres_container
    postgres_container=$(docker compose -f "$COMPOSE_FILE" ps -q postgres 2>/dev/null)
    if [ -n "$postgres_container" ]; then
      # Approximate "last DB reset" by postgres container creation time
      local pg_created
      pg_created=$(docker inspect --format='{{.Created}}' "$postgres_container" 2>/dev/null | cut -d'T' -f1 | tr -d '-' 2>/dev/null)
      local fid_mtime
      fid_mtime=$(stat -f '%Sm' -t '%Y%m%d' "$fid_path" 2>/dev/null || stat -c '%Y' "$fid_path" 2>/dev/null | head -c8 2>/dev/null)
      if [ -n "$pg_created" ] && [ -n "$fid_mtime" ] && [ "$fid_mtime" -lt "$pg_created" ] 2>/dev/null; then
        local f_text="fixture-ids.json is older than the last DB reset — stale ids may cause E2E errors"
        missing+=("$f_text")
      fi
    fi
  fi

  # ── Contamination sweep: detect tool-output XML artifacts in non-markdown files ──
  local contam_hits
  contam_hits=$(cmd_contamination_sweep) || missing+=("contamination: XML/tool artifacts found in source files (run 'grep -rnE write_to_file\|invoke\|parameter' to locate)")

  # ── Host capability check: verify this machine can run the current phase's requirements ──
  cmd_host_capability "$phase_val" || true  # records host.json; does not block doctor on its own

  for p in "${paths[@]}"; do
    if [ ! -f "$ROOT/$p" ]; then
      missing+=("$p")
    fi
  done
  if [ ${#missing[@]} -gt 0 ]; then
    local json="["
    for i in "${!missing[@]}"; do
      [ "$i" -gt 0 ] && json+=","
      json+="\"${missing[$i]}\""
    done
    json+="]"
    echo "$json"
    return 1
  fi
  echo "[]"
}

cmd_capabilities() {
  # Validate capabilities.json: every evidence reference must resolve to a real file,
  # test name, or E-number. Rule 5.1: no "present"/"absent" entry may be justified by
  # source reading alone. Exits nonzero with JSON list of broken references.
  shift
  local want_json=false
  json_out "$@" && want_json=true

  local cap_file="$ROOT/docs/capabilities/capabilities.json"
  if [ ! -f "$cap_file" ]; then
    $want_json && echo '{"error":"capabilities.json not found"}' || echo "✗ capabilities.json not found"
    return 1
  fi

  local errors=()
  local warnings=()

  # ── Validate REST entries ──
  local rest_count=$(jq '.rest | length' "$cap_file")
  for ((i=0; i<rest_count; i++)); do
    local entry
    entry=$(jq -r ".rest[$i]" "$cap_file")
    local method=$(echo "$entry" | jq -r '.method')
    local path=$(echo "$entry" | jq -r '.path')
    local status=$(echo "$entry" | jq -r '.status')
    local evidence=$(echo "$entry" | jq -r '.evidence // empty')
    local label="REST ${method} ${path}"

    if [ -z "$evidence" ]; then
      if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
        errors+=("${label}: no evidence (status=${status}) — Rule 5.1 violation")
      fi
      continue
    fi

    local resolved rc
    set +e
    resolved=$(_resolve_evidence "$evidence" "$label" "$status" "$cap_file")
    rc=$?
    set -e
    if [ $rc -ne 0 ]; then
      errors+=("$resolved")
    elif [ -n "$resolved" ]; then
      warnings+=("$resolved")
    fi
  done

  # ── Validate WS s2c entries ──
  local s2c_count=$(jq '.ws.s2c | length' "$cap_file")
  for ((i=0; i<s2c_count; i++)); do
    local entry
    entry=$(jq -r ".ws.s2c[$i]" "$cap_file")
    local op=$(echo "$entry" | jq -r '.op')
    local status=$(echo "$entry" | jq -r '.status')
    local evidence=$(echo "$entry" | jq -r '.evidence // empty')
    local label="WS s2c ${op}"

    if [ -z "$evidence" ]; then
      if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
        errors+=("${label}: no evidence (status=${status}) — Rule 5.1 violation")
      fi
      continue
    fi

    local resolved rc
    set +e
    resolved=$(_resolve_evidence "$evidence" "$label" "$status" "$cap_file")
    rc=$?
    set -e
    if [ $rc -ne 0 ]; then
      errors+=("$resolved")
    elif [ -n "$resolved" ]; then
      warnings+=("$resolved")
    fi
  done

  # ── Validate WS c2s entries ──
  local c2s_count=$(jq '.ws.c2s | length' "$cap_file")
  for ((i=0; i<c2s_count; i++)); do
    local entry
    entry=$(jq -r ".ws.c2s[$i]" "$cap_file")
    local op=$(echo "$entry" | jq -r '.op')
    local status=$(echo "$entry" | jq -r '.status')
    local evidence=$(echo "$entry" | jq -r '.evidence // empty')
    local label="WS c2s ${op}"

    if [ -z "$evidence" ]; then
      if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
        errors+=("${label}: no evidence (status=${status}) — Rule 5.1 violation")
      fi
      continue
    fi

    local resolved rc
    set +e
    resolved=$(_resolve_evidence "$evidence" "$label" "$status" "$cap_file")
    rc=$?
    set -e
    if [ $rc -ne 0 ]; then
      errors+=("$resolved")
    elif [ -n "$resolved" ]; then
      warnings+=("$resolved")
    fi
  done

  # ── Validate gaps ──
  local gaps_count=$(jq '.gaps | length' "$cap_file")
  for ((i=0; i<gaps_count; i++)); do
    local gap_id=$(jq -r ".gaps[$i].id" "$cap_file")
    local evidence_path=$(jq -r ".gaps[$i].evidencePath // empty" "$cap_file")
    local label="Gap ${gap_id}"

    if [ -z "$evidence_path" ]; then
      errors+=("${label}: no evidencePath")
      continue
    fi

    if [ -f "$ROOT/$evidence_path" ]; then
      : # ok
    elif echo "$evidence_path" | grep -q '#'; then
      local base="${evidence_path%%#*}"
      if [ ! -f "$ROOT/$base" ]; then
        errors+=("${label}: evidencePath '${evidence_path}' — base file not found")
      fi
    else
      errors+=("${label}: evidencePath '${evidence_path}' — file not found")
    fi
  done

  # ── Report ──
  if $want_json; then
    printf '{"errors":%s,"warnings":%s}\n' \
      "$(printf '%s\n' "${errors[@]}" | jq -R . | jq -s .)" \
      "$(printf '%s\n' "${warnings[@]}" | jq -R . | jq -s .)"
  else
    if [ ${#warnings[@]} -gt 0 ]; then
      for w in "${warnings[@]}"; do echo "  ⚠ $w"; done
    fi
    if [ ${#errors[@]} -gt 0 ]; then
      echo "✗ capabilities validation failed:"
      for e in "${errors[@]}"; do echo "  ✗ $e"; done
    else
      echo "✓ capabilities validation pass"
    fi
  fi

  [ ${#errors[@]} -eq 0 ] || return 1
}

_resolve_evidence() {
  # Resolves an evidence reference string. Returns 0 if resolved, 1 if broken.
  # Prints error string to stdout on failure, empty string on success.
  local evidence="$1" label="$2" status="$3" cap_file="$4"

  # Check for source-reading justifications (Rule 5.1)
  case "$evidence" in
    "route exists"*|"implied by"*|"mentioned in"*|"source reading"*)
      if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
        echo "${label}: evidence='${evidence}' — source reading not allowed for status=${status} (Rule 5.1)"
        return 1
      fi
      echo ""
      return 0
      ;;
  esac

  # E-number reference (e.g., "E1", "E2")
  if echo "$evidence" | grep -qE '^E[0-9]+$'; then
    local e_out_txt="$ROOT/docs/capabilities/experiment-outputs/${evidence}.txt"
    local e_out_json="$ROOT/docs/capabilities/experiment-outputs/${evidence}.json"
    if [ -f "$e_out_txt" ] || [ -f "$e_out_json" ]; then
      echo ""
      return 0
    fi
    echo "${label}: evidence=${evidence} — no experiment output found"
    return 1
  fi

  # stack health check (special)
  if [ "$evidence" = "stack health check" ]; then
    echo ""
    return 0
  fi

  # File path reference (may include #test-fragment after the file path)
  if echo "$evidence" | grep -qE '^(docs|apps|specs|contracts|tools)/'; then
    local file_path="${evidence%%#*}"
    if [ -f "$ROOT/$file_path" ]; then
      echo ""
      return 0
    fi
    echo "${label}: evidence='${evidence}' — file not found"
    return 1
  fi

  # Unrecognized — treat as source reading
  if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
    echo "${label}: evidence='${evidence}' — unrecognized format (Rule 5.1)"
    return 1
  fi
  echo ""
  return 0
}

cmd_host_capability() {
  # ── Host-capability check ──────────────────────────────────────────
  # Emits artifacts/doctor/host.json with OS, arch, virtualization path,
  # Docker, Android SDK, Maestro, Xcode, RAM, free disk.
  # Fails with named reasons if the environment cannot support what the
  # CURRENT phase requires.
  local phase="${1:-0}"
  local issues=()
  local out_dir="$ROOT/artifacts/doctor"
  mkdir -p "$out_dir"

  local os_name arch virt_path
  os_name=$(uname -s)
  arch=$(uname -m)
  virt_path=""
  case "$os_name-$arch" in
    Darwin-arm64) virt_path="hvf";;
    Darwin-x86_64) virt_path="hvf";;
    Linux-x86_64) virt_path="kvm";;
    Linux-aarch64) virt_path="kvm";;
    *) virt_path="unsupported";;
  esac

  # ── Docker ──
  local docker_ok="false" docker_version=""
  if command -v docker &>/dev/null && docker info &>/dev/null 2>&1; then
    docker_ok="true"
    docker_version=$(docker info --format '{{.ServerVersion}}' 2>/dev/null || echo "unknown")
  fi

  # ── Android SDK / Emulator ──
  local android_sdk_ok="false" android_image_arch=""
  if [ -n "${ANDROID_HOME:-}" ] && command -v emulator &>/dev/null && command -v adb &>/dev/null; then
    android_sdk_ok="true"
    # Detect installed image arch
    if [ -d "$ANDROID_HOME/system-images/android-34/google_apis/arm64-v8a" ]; then
      android_image_arch="arm64-v8a"
    elif [ -d "$ANDROID_HOME/system-images/android-34/google_apis/x86_64" ]; then
      android_image_arch="x86_64"
    fi
  fi

  # ── Maestro ──
  local maestro_ok="false" maestro_version=""
  if command -v maestro &>/dev/null; then
    maestro_ok="true"
    maestro_version=$(maestro --version 2>&1 | head -1)
  fi

  # ── Xcode / iOS Simulator ──
  local xcode_ok="false" xcode_version="" ios_sim="unavailable"
  if command -v xcodebuild &>/dev/null; then
    xcode_ok="true"
    xcode_version=$(xcodebuild -version 2>&1 | head -1)
    if xcrun simctl list runtimes 2>/dev/null | grep -q 'iOS'; then
      ios_sim="available"
    fi
  fi

  # ── RAM / Disk ──
  local ram_gb="0" free_disk_gb="0"
  if [[ "$os_name" == "Darwin" ]]; then
    ram_gb=$(sysctl -n hw.memsize 2>/dev/null | awk '{printf "%.0f", $1/1024/1024/1024}')
    free_disk_gb=$(df -g . 2>/dev/null | awk 'NR==2{print $4}')
  else
    ram_gb=$(free -g 2>/dev/null | awk 'NR==2{print $2}')
    free_disk_gb=$(df -BG . 2>/dev/null | awk 'NR==2{print $4}' | tr -d 'G')
  fi

  # ── Phase-aware checks ──
  # Phase 0: Docker must be present
  if [ "$docker_ok" != "true" ]; then
    issues+=("docker unavailable: Docker daemon is not running or not installed")
  fi

  # Phase 1+: Android SDK + emulator + Maestro required
  if [ "$phase" -ge 1 ]; then
    if [ "$android_sdk_ok" != "true" ]; then
      issues+=("android_sdk: Android SDK, emulator, and adb required for Phase 1+ E2E (run tools/setup-android-toolchain.sh)")
    fi
    if [ "$maestro_ok" != "true" ]; then
      issues+=("maestro: Maestro CLI required for Phase 1+ E2E (curl -Ls https://get.maestro.mobile.dev | bash)")
    fi
  fi

  # Phase 2+: Two-emulator rig requires ~14 GB free RAM (2×6 GB + Docker stack)
  if [ "$phase" -ge 2 ] && [ "$ram_gb" != "0" ] && [ "$ram_gb" -lt 14 ]; then
    issues+=("ram: ${ram_gb}GB available — Phase 2+ two-emulator rig requires ≥14GB free RAM")
  fi

  # iOS Simulator: optional, not required; recorded for traceability
  if [ "$xcode_ok" != "true" ]; then
    ios_sim="unavailable"
  fi

  # ── Build and emit host.json ──
  local host_json
  host_json=$(cat <<JSON
{
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "phase": $phase,
  "os": "$os_name",
  "arch": "$arch",
  "virt": "$virt_path",
  "ram_gb": $ram_gb,
  "free_disk_gb": $free_disk_gb,
  "docker": {"available": $docker_ok, "version": "$docker_version"},
  "android_sdk": {"available": $android_sdk_ok, "image_arch": "$android_image_arch"},
  "maestro": {"available": $maestro_ok, "version": "$maestro_version"},
  "xcode": {"available": $xcode_ok, "version": "$xcode_version", "ios_simulator": "$ios_sim"},
  "issues": $(printf '%s\n' "${issues[@]}" | jq -R . | jq -s .)
}
JSON
)
  echo "$host_json" > "$out_dir/host.json"

  if [ ${#issues[@]} -gt 0 ]; then
    echo "  ⚠ host capability issues:"
    for issue in "${issues[@]}"; do echo "    - $issue"; done
    return 1
  fi
  return 0
}

cmd_stack_seed() {
  echo "[devctl] running seed fixtures…"
  node "$ROOT/tools/seed/seed.mjs" || {
    echo "  ✗ seed failed"
    return 1
  }
  # Verify fixture-ids.json was produced
  if [ -f "$ROOT/tools/seed/fixture-ids.json" ]; then
    echo "  ✓ seed complete — fixture-ids.json generated"
  else
    echo "  ✗ seed did not produce fixture-ids.json"
    return 1
  fi
}

# ── Global JSON output toggle for verify ──
VERIFY_JSON=false

cmd_verify() {
  local only_layer="${1:-}"
  # Check for --json flag
  for a in "$@"; do [ "$a" = "--json" ] && VERIFY_JSON=true; done
  echo "[devctl] verify — Phase 0 signoff gates"

  # 0. Doctor — assert required artifacts exist
  if [ "$only_layer" = "" ] || [ "$only_layer" = "doctor" ]; then
    echo "[devctl] doctor — checking required artifacts…"
    local doctor_out
    doctor_out=$(cmd_doctor) || {
      echo "  ✗ doctor failed — missing artifacts: $doctor_out"
      exit 1
    }
    echo "  ✓ doctor pass — all required artifacts present"
  fi

  # 1. Health
  if [ "$only_layer" = "" ] || [ "$only_layer" = "health" ]; then
    cmd_stack_health --json || {
      echo "  ✗ stack health failed"
      exit 1
    }
  fi

  # 2. Codegen check — generated types must not drift from contracts
  if [ "$only_layer" = "" ] || [ "$only_layer" = "codegen" ]; then
    echo "[devctl] codegen --check (contract → type drift gate)…"
    if ! node "$ROOT/tools/codegen/gen.mjs" --check 2>&1; then
      echo "  ✗ codegen drift — regenerate with: node tools/codegen/gen.mjs"
      exit 1
    fi
    echo "  ✓ codegen pass"
  fi

  # 3. Contract tests (provider + consumer)
  if [ "$only_layer" = "" ] || [ "$only_layer" = "contract" ]; then
    echo "[devctl] running contract tests (provider + consumer)…"
    (cd "$ROOT/apps/api" && npx jest --config jest-contract.config.js --forceExit --json 2>&1) || {
      echo "  ✗ contract tests failed"
      exit 1
    }
    echo "  ✓ contract tests pass"
  fi

  # 4. Characterization tests
  if [ "$only_layer" = "" ] || [ "$only_layer" = "char" ]; then
    echo "[devctl] running characterization tests…"
    (cd "$ROOT/apps/api" && npx jest --config jest-char.config.js --forceExit --json 2>&1) || {
      echo "  ✗ characterization tests failed"
      exit 1
    }
    echo "  ✓ characterization tests pass"
  fi

  # 5. Traceability — every FR of every COMPLETED phase must keep its @satisfies
  # annotation (losing one is a regression). The in-progress phase's FRs are due
  # at its signoff, not on the day it opens — same phase-exit semantics as the
  # NFR ratchet. .phase = the phase currently in progress, so completed = .phase-1.
  if [ "$only_layer" = "" ] || [ "$only_layer" = "trace" ]; then
    local cur_phase done_phase
    cur_phase=$(read_phase)
    done_phase=$(( cur_phase > 0 ? cur_phase - 1 : 0 ))
    echo "[devctl] trace check — verifying completed phases 0–${done_phase} keep their @satisfies annotations…"
    cmd_trace check --phase "$done_phase" || {
      echo "  ✗ trace check failed"
      exit 1
    }
    echo "  ✓ trace pass"
  fi

  # 6. NFR harness — budget breaches, script errors, and NFRs left unarmed past
  # the phase they were promised in. Cheap at Phase 0 (one armed check); the
  # ratchet is what stops blocked stubs from aging into decoration.
  if [ "$only_layer" = "" ] || [ "$only_layer" = "nfr" ]; then
    echo "[devctl] nfr harness — budgets + phase ratchet…"
    cmd_nfr || {
      echo "  ✗ nfr harness failed"
      exit 1
    }
  fi

  echo "  ✓ verify pass"
}

usage() {
  cat <<EOF
devctl — OpenChat dev stack manager

Usage:  ./tools/devctl <command> [flags]

Commands:
  stack up      Start dev stack (docker compose up --build)
  stack down    Stop dev stack
  stack reset   Down + remove volumes + up (fresh state)
  stack logs    Tail all service logs (pass extra args to docker compose logs)
  stack health  Health-check every service; --json for machine-readable output
  stack seed    Run seed fixtures (tools/seed/seed.mjs)
  doctor        Assert all required artifacts exist; exits nonzero with JSON list of missing paths
  capabilities  Validate capabilities.json evidence references resolve (--json for machine output)
  verify        Run full verification suite (doctor + health + codegen + contract + char + trace + nfr); --json
  selftest      Prove gates catch failures by injecting faults (mutates — not for verify)
  trace         Check or report FR/NFR ↔ test traceability matrix (check|report [--phase N])
  nfr           Run the NFR budget harness; fails on breach, script error, or an
                NFR left unarmed past the phase it was promised in (--json)
  device up     Boot Android emulator(s) (Pixel 6a, API 34); provisions AVD if needed
  e2e           Run Maestro E2E flows against connected emulator(s) [--json] [<flow>]
  screenshot    Capture the emulator screen to artifacts/e2e/screens/<name>.png
                (--screen <name>; verifies PNG magic bytes)
  netcheck      Assert the emulator reaches the host (10.0.2.2) and the API answers
  commit        Safe commit: fail if tree is dirty, warn about untracked files

Flags:
  --json        Emit machine-readable JSON (health + verify)

Docs: tools/devctl-README.md
EOF
}

cmd_nfr() {
  # NFR harness (04 §8). Fails on a budget breach, on a script error, and on any
  # NFR left unarmed after the phase it was promised in (the ratchet in
  # tools/nfr/lib.sh) — a blocked stub cannot stay green across a phase bump.
  node "$ROOT/tools/nfr/nfr-runner.mjs" "$@"
}

cmd_screenshot() {
  # Capture the connected emulator's screen to an artifact (06 §7).
  # Verifies the PNG magic bytes: a truncated or empty capture that still
  # produced a file would otherwise look like a successful run.
  local screen=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --screen) screen="${2:-}"; shift 2;;
      *) shift;;
    esac
  done
  if [ -z "$screen" ]; then
    echo "✗ devctl screenshot: --screen <name> is required"
    return 1
  fi

  # shellcheck source=tools/env.sh
  source "$ROOT/tools/env.sh"

  local devices
  devices=$(adb devices 2>/dev/null | grep -cE '\sdevice$' || true)
  if [ "$devices" -lt 1 ]; then
    echo "✗ devctl screenshot: no emulator connected (run: devctl device up)"
    return 1
  fi

  local out_dir="$ROOT/artifacts/e2e/screens"
  mkdir -p "$out_dir"
  local out="$out_dir/$screen.png"
  adb exec-out screencap -p > "$out" 2>/dev/null || {
    echo "✗ devctl screenshot: adb screencap failed"
    return 1
  }

  # PNG magic: 89 50 4E 47
  local magic
  magic=$(head -c 4 "$out" | od -An -tx1 | tr -d ' \n')
  if [ "$magic" != "89504e47" ]; then
    echo "✗ devctl screenshot: $out is not a PNG (magic=$magic) — capture failed"
    rm -f "$out"
    return 1
  fi

  local bytes
  bytes=$(wc -c < "$out" | tr -d ' ')
  echo "  ✓ screenshot: artifacts/e2e/screens/$screen.png ($bytes bytes)"
}

cmd_trace() {
  local mode="${1:-check}"
  local phase_arg=""
  if [ "${2:-}" = "--phase" ] && [ -n "${3:-}" ]; then
    phase_arg="--phase $3"
  elif [ "$mode" = "check" ] || [ "$mode" = "report" ]; then
    # No --phase given: default to current phase from .phase (0..N cumulative)
    phase_arg="--phase $(read_phase)"
  fi
  node "$ROOT/tools/trace.mjs" "$mode" $phase_arg
}

cmd_selftest() {
  # Deliberately break one thing per layer and assert the corresponding gate fails.
  # Mutates test files — NOT wired into verify (verify reads, selftest mutates).
  echo "[devctl] selftest — proving each gate layer catches failures"
  local failures=0

  # ── Doctor: temporarily rename a required artifact ──
  local doctor_path="$ROOT/docs/BACKLOG.md"
  if [ -f "$doctor_path" ]; then
    mv "$doctor_path" "$ROOT/docs/BACKLOG.md.selftest-tmp"
    if cmd_doctor > /dev/null 2>&1; then
      echo "  ✗ doctor: did not catch missing BACKLOG.md"
      failures=$((failures + 1))
    else
      echo "  ✓ doctor: caught missing artifact"
    fi
    mv "$ROOT/docs/BACKLOG.md.selftest-tmp" "$doctor_path"
  fi

  # ── Contamination: inject XML markers into a .sh and a .mjs file, assert doctor catches them ──
  # Restore from a byte-exact backup rather than `sed '$d'`: a file with no
  # trailing newline makes the first appended marker join the last real line, so
  # deleting "the last line" ate a line of source. That silently corrupted
  # tools/diag-provider.mjs on every run (both vars also pointed at the same
  # file, so the .sh half was never covered).
  local contam_sh="$ROOT/tools/mut1.sh"
  local contam_mjs="$ROOT/tools/diag-provider.mjs"
  if [ -f "$contam_sh" ] && [ -f "$contam_mjs" ]; then
    cp "$contam_sh" "$contam_sh.selftest-bak"
    cp "$contam_mjs" "$contam_mjs.selftest-bak"
    printf '\n</write_to_file>\n' >> "$contam_sh"
    printf '\n</write_to_file>\n' >> "$contam_mjs"
    if cmd_doctor > /dev/null 2>&1; then
      echo "  ✗ contamination: doctor did not catch injected XML markers"
      failures=$((failures + 1))
    else
      echo "  ✓ contamination: doctor caught injected markers"
    fi
    mv "$contam_sh.selftest-bak" "$contam_sh"
    mv "$contam_mjs.selftest-bak" "$contam_mjs"
    if ! git -C "$ROOT" diff --quiet -- "$contam_sh" "$contam_mjs"; then
      echo "  ✗ contamination: restore left $contam_sh / $contam_mjs modified"
      failures=$((failures + 1))
    fi
  fi

  # ── Contract: break one test assertion ──
  local contract_test="$ROOT/apps/api/test/contract/provider.spec.ts"
  if [ -f "$contract_test" ]; then
    cp "$contract_test" "$contract_test.selftest-bak"
    sed -i '' 's/expect(r.status).toBe(200);$/expect(r.status).toBe(99999);/' "$contract_test"
    set +e
    (cd "$ROOT/apps/api" && npx jest --config jest-contract.config.js --forceExit 2>&1 > /dev/null)
    local contract_rc=$?
    set -e
    cp "$contract_test.selftest-bak" "$contract_test" && rm "$contract_test.selftest-bak"
    if [ "$contract_rc" -ne 0 ]; then
      echo "  ✓ contract: caught broken test (exit $contract_rc)"
    else
      echo "  ✗ contract: did not catch broken test"
      failures=$((failures + 1))
    fi
  fi

  # ── Char: break one characterization test ──
  local char_test="$ROOT/apps/api/test/characterization/auth.spec.ts"
  if [ -f "$char_test" ]; then
    cp "$char_test" "$char_test.selftest-bak"
    sed -i '' 's/expect(res.status).toBe(200);$/expect(res.status).toBe(99999);/' "$char_test"
    set +e
    (cd "$ROOT/apps/api" && npx jest --config jest-char.config.js --forceExit 2>&1 > /dev/null)
    local char_rc=$?
    set -e
    cp "$char_test.selftest-bak" "$char_test" && rm "$char_test.selftest-bak"
    if [ "$char_rc" -ne 0 ]; then
      echo "  ✓ char: caught broken test (exit $char_rc)"
    else
      echo "  ✗ char: did not catch broken test"
      failures=$((failures + 1))
    fi
  fi

  # ── Trace: delete an existing @satisfies annotation, assert trace check fails ──
  # Find a file with @satisfies; if none exist yet (Phase 0), this layer is untestable
  local trace_test=""
  trace_test=$(grep -rl '@satisfies' "$ROOT" --include='*.ts' --include='*.mjs' --include='*.js' --include='*.md' 2>/dev/null | grep -v node_modules | grep -v '.git/' | head -n1)
  if [ -n "$trace_test" ]; then
    cp "$trace_test" "$trace_test.selftest-bak"
    # Remove the first @satisfies line
    sed -i '' '/@satisfies/d' "$trace_test"
    if cmd_trace check > /dev/null 2>&1; then
      echo "  ✗ trace: did not catch deleted @satisfies annotation"
      failures=$((failures + 1))
    else
      echo "  ✓ trace: caught deleted annotation"
    fi
    cp "$trace_test.selftest-bak" "$trace_test" && rm "$trace_test.selftest-bak"
  else
    echo "  — trace: no @satisfies annotations exist yet (Phase 0 — expected)"
  fi

  # ── NFR ratchet: advance .phase past every arm_at_phase and assert the
  # ── blocked stubs flip to overdue. This is the proof that a blocked NFR
  # ── cannot stay green across a phase bump — the whole point of P0-16.
  local phase_file="$ROOT/.phase"
  local real_phase
  real_phase="$(read_phase)"
  cp "$phase_file" "$phase_file.selftest-bak" 2>/dev/null || echo "$real_phase" > "$phase_file.selftest-bak"
  echo "9" > "$phase_file"
  set +e
  local nfr_out nfr_rc
  nfr_out=$(cmd_nfr 2>&1)
  nfr_rc=$?
  set -e
  cp "$phase_file.selftest-bak" "$phase_file" && rm "$phase_file.selftest-bak"
  local overdue_count
  overdue_count=$(echo "$nfr_out" | grep -c '\[overdue\]' || true)
  if [ "$nfr_rc" -ne 0 ] && [ "$overdue_count" -gt 0 ]; then
    echo "  ✓ nfr: caught $overdue_count NFR(s) left unarmed past their phase (exit $nfr_rc)"
  else
    echo "  ✗ nfr: phase bump to 9 did not turn blocked stubs overdue (exit $nfr_rc, $overdue_count overdue)"
    failures=$((failures + 1))
  fi
  # Assert the restore worked — a selftest that corrupts .phase would be worse
  # than the gap it tests for.
  if [ "$(read_phase)" != "$real_phase" ]; then
    echo "  ✗ nfr: .phase not restored (expected $real_phase, got $(read_phase))"
    failures=$((failures + 1))
  fi

  if [ "$failures" -gt 0 ]; then
    echo "  ✗ selftest: $failures layer(s) failed to catch injected faults"
    return 1
  fi
  echo "  ✓ selftest: all layers catch injected faults"
}

cmd_commit() {
  # Fail loudly if tree is dirty (no staging area ambiguity)
  if ! git -C "$ROOT" diff-index --quiet HEAD -- 2>/dev/null; then
    echo "✗ devctl commit: working tree is dirty (tracked files modified)"
    echo "  Unstaged changes:"
    git -C "$ROOT" diff --name-only -- ':(exclude)node_modules' 2>/dev/null
    echo "  Staged changes:"
    git -C "$ROOT" diff --name-only --cached -- ':(exclude)node_modules' 2>/dev/null
    echo "  Stage or stash before committing."
    return 1
  fi
  # Check for untracked files that should be committed
  local untracked
  untracked=$(git -C "$ROOT" ls-files --others --exclude-standard -- ':(exclude)node_modules' 2>/dev/null)
  if [ -n "$untracked" ]; then
    echo "⚠ devctl commit: untracked files present — consider staging them:"
    echo "$untracked" | sed 's/^/  /'
  fi

  # Pass through to git commit
  git -C "$ROOT" commit "$@"
}

cmd_device_up() {
  # Boot Android emulator(s). Provisions AVD if needed.
  # --second boots only :5556; default boots both :5554 and :5556.
  echo "[devctl] device up — provisioning Android emulator(s)…"
  bash "$ROOT/tools/device-up.sh" "$@"
}

cmd_e2e() {
  shift
  # Run Maestro E2E flows against connected emulator(s).
  # --json emits machine-readable results. Exit 0 = all flows pass, 1 = any fail.
  # env E2E=1 signals the app to use frozen clock / test shims.
  local want_json=false
  json_out "$@" && want_json=true

  local flow_file="${1:-}"
  local flows_dir="$ROOT/apps/mobile/e2e/flows"

  if ! command -v maestro &>/dev/null; then
    echo "✗ Maestro CLI not found on PATH"
    echo "  Install: curl -Ls 'https://get.maestro.mobile.dev' | bash"
    return 1
  fi

  if [ ! -d "$flows_dir" ]; then
    echo "✗ E2E flows directory not found: $flows_dir"
    return 1
  fi

  # Check at least one device is connected
  local adb_devices
  adb_devices=$(adb devices 2>/dev/null | grep -v 'List of devices' | grep -v '^$' | wc -l | tr -d ' ')
  if [ "$adb_devices" -lt 1 ]; then
    echo "✗ No Android device/emulator connected (run: devctl device up)"
    return 1
  fi

  export E2E=1

  if [ -n "$flow_file" ]; then
    # Run a specific flow
    local flow_path=""
    if [ -f "$flows_dir/$flow_file" ]; then
      flow_path="$flows_dir/$flow_file"
    elif [ -f "$flow_file" ]; then
      flow_path="$flow_file"
    else
      echo "✗ Flow file not found: $flow_file (looked in $flows_dir/ and .)"
      return 1
    fi
    echo "[devctl] e2e — running flow: $flow_file"
    if maestro test "$flow_path" 2>&1; then
      echo "  ✓ $flow_file passed"
    else
      echo "  ✗ $flow_file failed"
      return 1
    fi
  else
    # Run all flows
    echo "[devctl] e2e — running all Maestro flows"
    local failures=0
    for flow in "$flows_dir"/*.yaml; do
      local flow_name
      flow_name=$(basename "$flow")
      echo "  → $flow_name"
      if maestro test "$flow" 2>&1; then
        echo "    ✓ pass"
      else
        echo "    ✗ fail"
        failures=$((failures + 1))
      fi
    done
    if [ "$failures" -gt 0 ]; then
      echo "  ✗ e2e: $failures flow(s) failed"
      return 1
    fi
    echo "  ✓ e2e: all flows pass"
  fi
}

# Route subcommand
case "${1:-}" in
  stack)
    case "${2:-}" in
      up)     shift 2; cmd_stack_up "$@";;
      down)   shift 2; cmd_stack_down "$@";;
      reset)  shift 2; cmd_stack_reset "$@";;
      logs)   cmd_stack_logs "$@";;
      health) cmd_stack_health "$@";;
      seed)   cmd_stack_seed "$@";;
      *)      usage; exit 1;;
    esac
    ;;
  doctor)        cmd_doctor "$@";;
  capabilities)  cmd_capabilities "$@";;
  verify)        shift; cmd_verify "$@";;
  selftest)      cmd_selftest "$@";;
  trace)         shift; cmd_trace "$@";;
  nfr)           shift; cmd_nfr "$@";;
  screenshot)    shift; cmd_screenshot "$@";;
  netcheck)      shift; bash "$ROOT/tools/probe/emulator-net.sh" "$@";;
  device)        shift; cmd_device_up "$@";;
  e2e)           cmd_e2e "$@";;
  commit)        shift; cmd_commit "$@";;
  *) usage; exit 1;;
esac
