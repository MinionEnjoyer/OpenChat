#!/usr/bin/env bash
# devctl — dev stack lifecycle management for OpenChat
# Usage: ./tools/devctl stack up|down|reset|logs|health [--json]
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
COMPOSE_FILE="$ROOT/docker-compose.dev.yml"
COMPOSE_CMD="docker compose -f $COMPOSE_FILE"

json_out() {
  # --json flag present anywhere in args → emit JSON
  for a in "$@"; do [ "$a" = "--json" ] && return 0; done
  return 1
}

cmd_stack_up() {
  echo "[devctl] starting dev stack…"
  $COMPOSE_CMD up --build -d "$@"
}

cmd_stack_down() {
  echo "[devctl] stopping dev stack…"
  $COMPOSE_CMD down "$@"
}

cmd_stack_reset() {
  echo "[devctl] resetting dev stack (down + volumes + up)…"
  $COMPOSE_CMD down -v "$@"
  $COMPOSE_CMD up --build -d "$@"
}

cmd_stack_logs() {
  shift # consume 'logs'
  $COMPOSE_CMD logs "$@"
}

cmd_stack_health() {
  shift # consume 'health'
  local failures=0 r_pg="" r_rd="" r_ap="" r_wb="" r_lk="" r_os="" r_ah=""
  local want_json=false
  json_out "$@" && want_json=true

  echo "[devctl] health check…"

  # postgres
  if nc -z -w 3 localhost 5432 2>/dev/null; then
    $want_json && r_pg="ok" || echo "  ✓ postgres (localhost:5432)"
  else
    failures=$((failures + 1))
    $want_json && r_pg="unreachable" || echo "  ✗ postgres (localhost:5432) — unreachable"
  fi

  # redis
  if nc -z -w 3 localhost 6379 2>/dev/null; then
    $want_json && r_rd="ok" || echo "  ✓ redis (localhost:6379)"
  else
    failures=$((failures + 1))
    $want_json && r_rd="unreachable" || echo "  ✗ redis (localhost:6379) — unreachable"
  fi

  # api
  if nc -z -w 3 localhost 3001 2>/dev/null; then
    $want_json && r_ap="ok" || echo "  ✓ api (localhost:3001)"
  else
    failures=$((failures + 1))
    $want_json && r_ap="unreachable" || echo "  ✗ api (localhost:3001) — unreachable"
  fi

  # web
  if nc -z -w 3 localhost 3000 2>/dev/null; then
    $want_json && r_wb="ok" || echo "  ✓ web (localhost:3000)"
  else
    failures=$((failures + 1))
    $want_json && r_wb="unreachable" || echo "  ✗ web (localhost:3000) — unreachable"
  fi

  # livekit
  if nc -z -w 3 localhost 7880 2>/dev/null; then
    $want_json && r_lk="ok" || echo "  ✓ livekit (localhost:7880)"
  else
    failures=$((failures + 1))
    $want_json && r_lk="unreachable" || echo "  ✗ livekit (localhost:7880) — unreachable"
  fi

  # openshare
  if nc -z -w 3 localhost 8800 2>/dev/null; then
    $want_json && r_os="ok" || echo "  ✓ openshare (localhost:8800)"
  else
    failures=$((failures + 1))
    $want_json && r_os="unreachable" || echo "  ✗ openshare (localhost:8800) — unreachable"
  fi

  # API health endpoint (200 = ok)
  if curl -sf -o /dev/null "http://localhost:3001/api/health" 2>/dev/null; then
    $want_json && r_ah="ok" || echo "  ✓ GET /api/health → 200"
  else
    failures=$((failures + 1))
    $want_json && r_ah="fail" || echo "  ✗ GET /api/health → failed"
  fi

  if $want_json; then
    printf '{"postgres":"%s","redis":"%s","api":"%s","web":"%s","livekit":"%s","openshare":"%s","api_health":"%s"}\n' \
      "${r_pg:-unknown}" "${r_rd:-unknown}" "${r_ap:-unknown}" "${r_wb:-unknown}" \
      "${r_lk:-unknown}" "${r_os:-unknown}" "${r_ah:-unknown}"
  fi

  return $failures
}

cmd_doctor() {
  # Assert presence of every required artifact. Exits nonzero with JSON list of missing paths.
  # Required artifacts per docs/audits/artifact-inventory.md — keep in sync.
  local missing=()
  local paths=(
    "contracts/x-attachment-shape.yaml"
    "docs/BACKLOG.md"
    "docs/DRIFT-LOG.md"
    "docs/LOG.md"
    "docs/audits/P0-04.md"
    "docs/audits/P0-04-remediation.md"
    "docs/audits/P0-04-verification.md"
    "docs/audits/artifact-inventory.md"
    "docs/capabilities/EXPERIMENTS.md"
    "docs/capabilities/experiment-outputs/E1.txt"
    "docs/capabilities/experiment-outputs/E2.json"
    "docs/capabilities/experiment-outputs/E3.json"
    "docs/capabilities/experiment-outputs/E4.txt"
    "docs/capabilities/experiment-outputs/E5.json"
    "docs/capabilities/experiment-outputs/E5.txt"
    "docs/capabilities/experiment-outputs/E6.json"
    "docs/capabilities/experiment-outputs/E7.json"
    "docs/capabilities/experiment-outputs/E8.json"
    "docs/capabilities/experiment-outputs/E9.txt"
    "docs/capabilities/experiment-outputs/E10.txt"
    "docs/capabilities/experiment-outputs/E11.json"
    "specs/00-MASTER-SPEC.md"
    "specs/05-AGENT-OPERATIONS.md"
    "specs/templates/T2-AUDIT-CHECKLIST.md"
    "tools/seed/seed.mjs"
    "tools/devctl"
    "tools/devctl-README.md"
  )
  # ── Stale fixture-ids.json check: if the file exists but is older than the last DB reset,
  # ── flag it so Phase 1 E2E doesn't silently reference wrong fixture ids.
  local fid_path="$ROOT/tools/seed/fixture-ids.json"
  if [ -f "$fid_path" ]; then
    local postgres_container
    postgres_container=$(docker compose -f "$COMPOSE_FILE" ps -q postgres 2>/dev/null)
    if [ -n "$postgres_container" ]; then
      # Approximate "last DB reset" by postgres container creation time
      local pg_created
      pg_created=$(docker inspect --format='{{.Created}}' "$postgres_container" 2>/dev/null | cut -d'T' -f1 | tr -d '-' 2>/dev/null)
      local fid_mtime
      fid_mtime=$(stat -f '%Sm' -t '%Y%m%d' "$fid_path" 2>/dev/null || stat -c '%Y' "$fid_path" 2>/dev/null | head -c8 2>/dev/null)
      if [ -n "$pg_created" ] && [ -n "$fid_mtime" ] && [ "$fid_mtime" -lt "$pg_created" ] 2>/dev/null; then
        local f_text="fixture-ids.json is older than the last DB reset — stale ids may cause E2E errors"
        missing+=("$f_text")
      fi
    fi
  fi

  for p in "${paths[@]}"; do
    if [ ! -f "$ROOT/$p" ]; then
      missing+=("$p")
    fi
  done
  if [ ${#missing[@]} -gt 0 ]; then
    local json="["
    for i in "${!missing[@]}"; do
      [ "$i" -gt 0 ] && json+=","
      json+="\"${missing[$i]}\""
    done
    json+="]"
    echo "$json"
    return 1
  fi
  echo "[]"
}

cmd_capabilities() {
  # Validate capabilities.json: every evidence reference must resolve to a real file,
  # test name, or E-number. Rule 5.1: no "present"/"absent" entry may be justified by
  # source reading alone. Exits nonzero with JSON list of broken references.
  shift
  local want_json=false
  json_out "$@" && want_json=true

  local cap_file="$ROOT/docs/capabilities/capabilities.json"
  if [ ! -f "$cap_file" ]; then
    $want_json && echo '{"error":"capabilities.json not found"}' || echo "✗ capabilities.json not found"
    return 1
  fi

  local errors=()
  local warnings=()

  # ── Validate REST entries ──
  local rest_count=$(jq '.rest | length' "$cap_file")
  for ((i=0; i<rest_count; i++)); do
    local entry
    entry=$(jq -r ".rest[$i]" "$cap_file")
    local method=$(echo "$entry" | jq -r '.method')
    local path=$(echo "$entry" | jq -r '.path')
    local status=$(echo "$entry" | jq -r '.status')
    local evidence=$(echo "$entry" | jq -r '.evidence // empty')
    local label="REST ${method} ${path}"

    if [ -z "$evidence" ]; then
      if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
        errors+=("${label}: no evidence (status=${status}) — Rule 5.1 violation")
      fi
      continue
    fi

    local resolved rc
    set +e
    resolved=$(_resolve_evidence "$evidence" "$label" "$status" "$cap_file")
    rc=$?
    set -e
    if [ $rc -ne 0 ]; then
      errors+=("$resolved")
    elif [ -n "$resolved" ]; then
      warnings+=("$resolved")
    fi
  done

  # ── Validate WS s2c entries ──
  local s2c_count=$(jq '.ws.s2c | length' "$cap_file")
  for ((i=0; i<s2c_count; i++)); do
    local entry
    entry=$(jq -r ".ws.s2c[$i]" "$cap_file")
    local op=$(echo "$entry" | jq -r '.op')
    local status=$(echo "$entry" | jq -r '.status')
    local evidence=$(echo "$entry" | jq -r '.evidence // empty')
    local label="WS s2c ${op}"

    if [ -z "$evidence" ]; then
      if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
        errors+=("${label}: no evidence (status=${status}) — Rule 5.1 violation")
      fi
      continue
    fi

    local resolved rc
    set +e
    resolved=$(_resolve_evidence "$evidence" "$label" "$status" "$cap_file")
    rc=$?
    set -e
    if [ $rc -ne 0 ]; then
      errors+=("$resolved")
    elif [ -n "$resolved" ]; then
      warnings+=("$resolved")
    fi
  done

  # ── Validate WS c2s entries ──
  local c2s_count=$(jq '.ws.c2s | length' "$cap_file")
  for ((i=0; i<c2s_count; i++)); do
    local entry
    entry=$(jq -r ".ws.c2s[$i]" "$cap_file")
    local op=$(echo "$entry" | jq -r '.op')
    local status=$(echo "$entry" | jq -r '.status')
    local evidence=$(echo "$entry" | jq -r '.evidence // empty')
    local label="WS c2s ${op}"

    if [ -z "$evidence" ]; then
      if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
        errors+=("${label}: no evidence (status=${status}) — Rule 5.1 violation")
      fi
      continue
    fi

    local resolved rc
    set +e
    resolved=$(_resolve_evidence "$evidence" "$label" "$status" "$cap_file")
    rc=$?
    set -e
    if [ $rc -ne 0 ]; then
      errors+=("$resolved")
    elif [ -n "$resolved" ]; then
      warnings+=("$resolved")
    fi
  done

  # ── Validate gaps ──
  local gaps_count=$(jq '.gaps | length' "$cap_file")
  for ((i=0; i<gaps_count; i++)); do
    local gap_id=$(jq -r ".gaps[$i].id" "$cap_file")
    local evidence_path=$(jq -r ".gaps[$i].evidencePath // empty" "$cap_file")
    local label="Gap ${gap_id}"

    if [ -z "$evidence_path" ]; then
      errors+=("${label}: no evidencePath")
      continue
    fi

    if [ -f "$ROOT/$evidence_path" ]; then
      : # ok
    elif echo "$evidence_path" | grep -q '#'; then
      local base="${evidence_path%%#*}"
      if [ ! -f "$ROOT/$base" ]; then
        errors+=("${label}: evidencePath '${evidence_path}' — base file not found")
      fi
    else
      errors+=("${label}: evidencePath '${evidence_path}' — file not found")
    fi
  done

  # ── Report ──
  if $want_json; then
    printf '{"errors":%s,"warnings":%s}\n' \
      "$(printf '%s\n' "${errors[@]}" | jq -R . | jq -s .)" \
      "$(printf '%s\n' "${warnings[@]}" | jq -R . | jq -s .)"
  else
    if [ ${#warnings[@]} -gt 0 ]; then
      for w in "${warnings[@]}"; do echo "  ⚠ $w"; done
    fi
    if [ ${#errors[@]} -gt 0 ]; then
      echo "✗ capabilities validation failed:"
      for e in "${errors[@]}"; do echo "  ✗ $e"; done
    else
      echo "✓ capabilities validation pass"
    fi
  fi

  [ ${#errors[@]} -eq 0 ] || return 1
}

_resolve_evidence() {
  # Resolves an evidence reference string. Returns 0 if resolved, 1 if broken.
  # Prints error string to stdout on failure, empty string on success.
  local evidence="$1" label="$2" status="$3" cap_file="$4"

  # Check for source-reading justifications (Rule 5.1)
  case "$evidence" in
    "route exists"*|"implied by"*|"mentioned in"*|"source reading"*)
      if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
        echo "${label}: evidence='${evidence}' — source reading not allowed for status=${status} (Rule 5.1)"
        return 1
      fi
      echo ""
      return 0
      ;;
  esac

  # E-number reference (e.g., "E1", "E2")
  if echo "$evidence" | grep -qE '^E[0-9]+$'; then
    local e_out_txt="$ROOT/docs/capabilities/experiment-outputs/${evidence}.txt"
    local e_out_json="$ROOT/docs/capabilities/experiment-outputs/${evidence}.json"
    if [ -f "$e_out_txt" ] || [ -f "$e_out_json" ]; then
      echo ""
      return 0
    fi
    echo "${label}: evidence=${evidence} — no experiment output found"
    return 1
  fi

  # stack health check (special)
  if [ "$evidence" = "stack health check" ]; then
    echo ""
    return 0
  fi

  # File path reference (may include #test-fragment after the file path)
  if echo "$evidence" | grep -qE '^(docs|apps|specs|contracts|tools)/'; then
    local file_path="${evidence%%#*}"
    if [ -f "$ROOT/$file_path" ]; then
      echo ""
      return 0
    fi
    echo "${label}: evidence='${evidence}' — file not found"
    return 1
  fi

  # Unrecognized — treat as source reading
  if [ "$status" = "present" ] || [ "$status" = "absent" ]; then
    echo "${label}: evidence='${evidence}' — unrecognized format (Rule 5.1)"
    return 1
  fi
  echo ""
  return 0
}

cmd_stack_seed() {
  echo "[devctl] running seed fixtures…"
  node "$ROOT/tools/seed/seed.mjs" || {
    echo "  ✗ seed failed"
    return 1
  }
  # Verify fixture-ids.json was produced
  if [ -f "$ROOT/tools/seed/fixture-ids.json" ]; then
    echo "  ✓ seed complete — fixture-ids.json generated"
  else
    echo "  ✗ seed did not produce fixture-ids.json"
    return 1
  fi
}

# ── Global JSON output toggle for verify ──
VERIFY_JSON=false

cmd_verify() {
  local only_layer="${1:-}"
  # Check for --json flag
  for a in "$@"; do [ "$a" = "--json" ] && VERIFY_JSON=true; done
  echo "[devctl] verify — Phase 0 signoff gates"

  # 0. Doctor — assert required artifacts exist
  if [ "$only_layer" = "" ] || [ "$only_layer" = "doctor" ]; then
    echo "[devctl] doctor — checking required artifacts…"
    local doctor_out
    doctor_out=$(cmd_doctor) || {
      echo "  ✗ doctor failed — missing artifacts: $doctor_out"
      exit 1
    }
    echo "  ✓ doctor pass — all required artifacts present"
  fi

  # 1. Health
  if [ "$only_layer" = "" ] || [ "$only_layer" = "health" ]; then
    cmd_stack_health --json || {
      echo "  ✗ stack health failed"
      exit 1
    }
  fi

  # 2. Codegen check — generated types must not drift from contracts
  if [ "$only_layer" = "" ] || [ "$only_layer" = "codegen" ]; then
    echo "[devctl] codegen --check (contract → type drift gate)…"
    if ! node "$ROOT/tools/codegen/gen.mjs" --check 2>&1; then
      echo "  ✗ codegen drift — regenerate with: node tools/codegen/gen.mjs"
      exit 1
    fi
    echo "  ✓ codegen pass"
  fi

  # 3. Contract tests (provider + consumer)
  if [ "$only_layer" = "" ] || [ "$only_layer" = "contract" ]; then
    echo "[devctl] running contract tests (provider + consumer)…"
    (cd "$ROOT/apps/api" && npx jest --config jest-contract.config.js --forceExit --json 2>&1) || {
      echo "  ✗ contract tests failed"
      exit 1
    }
    echo "  ✓ contract tests pass"
  fi

  # 4. Characterization tests
  if [ "$only_layer" = "" ] || [ "$only_layer" = "char" ]; then
    echo "[devctl] running characterization tests…"
    (cd "$ROOT/apps/api" && npx jest --config jest-char.config.js --forceExit --json 2>&1) || {
      echo "  ✗ characterization tests failed"
      exit 1
    }
    echo "  ✓ characterization tests pass"
  fi

  # 5. Traceability — every FR must have an @satisfies annotation
  if [ "$only_layer" = "" ] || [ "$only_layer" = "trace" ]; then
    echo "[devctl] trace check — verifying every requirement has an @satisfies test…"
    cmd_trace check || {
      echo "  ✗ trace check failed"
      exit 1
    }
    echo "  ✓ trace pass"
  fi

  echo "  ✓ verify pass"
}

usage() {
  cat <<EOF
devctl — OpenChat dev stack manager

Usage:  ./tools/devctl <command> [flags]

Commands:
  stack up      Start dev stack (docker compose up --build)
  stack down    Stop dev stack
  stack reset   Down + remove volumes + up (fresh state)
  stack logs    Tail all service logs (pass extra args to docker compose logs)
  stack health  Health-check every service; --json for machine-readable output
  stack seed    Run seed fixtures (tools/seed/seed.mjs)
  doctor        Assert all required artifacts exist; exits nonzero with JSON list of missing paths
  capabilities  Validate capabilities.json evidence references resolve (--json for machine output)
  verify        Run full verification suite (doctor + health + codegen + contract + char); --json
  selftest      Prove gates catch failures by injecting faults (mutates — not for verify)
  trace         Check or report FR/NFR ↔ test traceability matrix (check|report [--phase N])
  commit        Safe commit: fail if tree is dirty, warn about untracked files

Flags:
  --json        Emit machine-readable JSON (health + verify)

Docs: tools/devctl-README.md
EOF
}

cmd_trace() {
  local mode="${1:-check}"
  local phase_arg=""
  if [ "${2:-}" = "--phase" ] && [ -n "${3:-}" ]; then
    phase_arg="--phase $3"
  fi
  node "$ROOT/tools/trace.mjs" "$mode" $phase_arg
}

cmd_selftest() {
  # Deliberately break one thing per layer and assert the corresponding gate fails.
  # Mutates test files — NOT wired into verify (verify reads, selftest mutates).
  echo "[devctl] selftest — proving each gate layer catches failures"
  local failures=0

  # ── Doctor: temporarily rename a required artifact ──
  local doctor_path="$ROOT/docs/BACKLOG.md"
  if [ -f "$doctor_path" ]; then
    mv "$doctor_path" "$ROOT/docs/BACKLOG.md.selftest-tmp"
    if cmd_doctor > /dev/null 2>&1; then
      echo "  ✗ doctor: did not catch missing BACKLOG.md"
      failures=$((failures + 1))
    else
      echo "  ✓ doctor: caught missing artifact"
    fi
    mv "$ROOT/docs/BACKLOG.md.selftest-tmp" "$doctor_path"
  fi

  # ── Contract: break one test assertion ──
  local contract_test="$ROOT/apps/api/test/contract/provider.spec.ts"
  if [ -f "$contract_test" ]; then
    cp "$contract_test" "$contract_test.selftest-bak"
    sed -i '' 's/expect(r.status).toBe(200);$/expect(r.status).toBe(99999);/' "$contract_test"
    set +e
    (cd "$ROOT/apps/api" && npx jest --config jest-contract.config.js --forceExit 2>&1 > /dev/null)
    local contract_rc=$?
    set -e
    cp "$contract_test.selftest-bak" "$contract_test" && rm "$contract_test.selftest-bak"
    if [ "$contract_rc" -ne 0 ]; then
      echo "  ✓ contract: caught broken test (exit $contract_rc)"
    else
      echo "  ✗ contract: did not catch broken test"
      failures=$((failures + 1))
    fi
  fi

  # ── Char: break one characterization test ──
  local char_test="$ROOT/apps/api/test/characterization/auth.spec.ts"
  if [ -f "$char_test" ]; then
    cp "$char_test" "$char_test.selftest-bak"
    sed -i '' 's/expect(res.status).toBe(200);$/expect(res.status).toBe(99999);/' "$char_test"
    set +e
    (cd "$ROOT/apps/api" && npx jest --config jest-char.config.js --forceExit 2>&1 > /dev/null)
    local char_rc=$?
    set -e
    cp "$char_test.selftest-bak" "$char_test" && rm "$char_test.selftest-bak"
    if [ "$char_rc" -ne 0 ]; then
      echo "  ✓ char: caught broken test (exit $char_rc)"
    else
      echo "  ✗ char: did not catch broken test"
      failures=$((failures + 1))
    fi
  fi

  if [ "$failures" -gt 0 ]; then
    echo "  ✗ selftest: $failures layer(s) failed to catch injected faults"
    return 1
  fi
  echo "  ✓ selftest: all layers catch injected faults"
}

cmd_commit() {
  # Fail loudly if tree is dirty (no staging area ambiguity)
  if ! git -C "$ROOT" diff-index --quiet HEAD -- 2>/dev/null; then
    echo "✗ devctl commit: working tree is dirty (tracked files modified)"
    echo "  Unstaged changes:"
    git -C "$ROOT" diff --name-only -- ':(exclude)node_modules' 2>/dev/null
    echo "  Staged changes:"
    git -C "$ROOT" diff --name-only --cached -- ':(exclude)node_modules' 2>/dev/null
    echo "  Stage or stash before committing."
    return 1
  fi
  # Check for untracked files that should be committed
  local untracked
  untracked=$(git -C "$ROOT" ls-files --others --exclude-standard -- ':(exclude)node_modules' 2>/dev/null)
  if [ -n "$untracked" ]; then
    echo "⚠ devctl commit: untracked files present — consider staging them:"
    echo "$untracked" | sed 's/^/  /'
  fi

  # Pass through to git commit
  git -C "$ROOT" commit "$@"
}

# Route subcommand
case "${1:-}" in
  stack)
    case "${2:-}" in
      up)     shift 2; cmd_stack_up "$@";;
      down)   shift 2; cmd_stack_down "$@";;
      reset)  shift 2; cmd_stack_reset "$@";;
      logs)   cmd_stack_logs "$@";;
      health) cmd_stack_health "$@";;
      seed)   cmd_stack_seed "$@";;
      *)      usage; exit 1;;
    esac
    ;;
  doctor)        cmd_doctor "$@";;
  capabilities)  cmd_capabilities "$@";;
  verify)        shift; cmd_verify "$@";;
  selftest)      cmd_selftest "$@";;
  trace)         shift; cmd_trace "$@";;
  commit)        shift; cmd_commit "$@";;
  *) usage; exit 1;;
esac
