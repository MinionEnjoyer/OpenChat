# deps / build
node_modules/
node_modules
dist/
build/
.vite/
*.tsbuildinfo

# ── secrets & local config — NEVER commit ──────────────────────────────
# All personal data (keys, tokens, passwords, IPs) lives in these local files.
# Only the *.example / *.tmpl templates are tracked.
.env
.env.*
!.env.example
livekit.yaml
!livekit.yaml.tmpl
*.pem
*.key
*_rsa
*.p12

# internal specs / design sources / codegen — kept local, never uploaded
docs/SPEC.md
docs/architecture/
scripts/generate_*.py

# runtime
*.log
coverage/
.DS_Store

# local data
postgres-data/
redis-data/
!.env.dev.example

# NFR per-sha archives — regenerated each run; report.json is the tracked pointer
artifacts/nfr/*.json
!artifacts/nfr/report.json
tools/seed/fixture-ids.local.json

# Firebase client config — deployment-specific, each deployer supplies their own
apps/mobile/google-services.json
apps/mobile/GoogleService-Info.plist
